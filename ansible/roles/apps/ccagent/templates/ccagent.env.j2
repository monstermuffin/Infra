GIT_CRYPT_KEY={{ ccagent_git_crypt_key }}
{% if ccagent_infisical_enabled | bool %}
INFISICAL_API_URL={{ ccagent_infisical_api_url }}
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID={{ ccagent_infisical_client_id }}
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET={{ ccagent_infisical_client_secret }}
INFISICAL_PROJECT_ID={{ ccagent_infisical_project_id }}
INFISICAL_ENV_SLUG={{ ccagent_infisical_env_slug }}
ANSIBLE_VAULT_PASSWORD_FILE={{ ccagent_home }}/.local/bin/infisical-vault-password.sh
{% endif %}
{% if ccagent_github_app_private_key | length > 0 or ccagent_infisical_enabled | bool %}
GH_APP_ID={{ ccagent_github_app_id }}
GH_APP_INSTALLATION_ID={{ ccagent_github_app_installation_id }}
GH_APP_PRIVATE_KEY_PATH={% if ccagent_infisical_enabled | bool %}/run/ccagent-secrets/github-app-private-key.pem{% else %}{{ ccagent_home }}/.github-app/private-key.pem{% endif %}
{% endif %}
